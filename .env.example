# Environment Configuration for AI Research Paper Assistant
# Copy this file to .env and insert your API keys

# Gemini API Key (Google AI Studio)
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Semantic Scholar API Key (Optional: increases rate limits from 100/5min to high throughput)
SEMANTIC_SCHOLAR_API_KEY=

# Default Models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
